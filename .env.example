# =====================================================
# Alpaca Market Data API (https://alpaca.markets/)
# =====================================================
ALPACA_API_KEY=PK3L6Z42IKVYVZ4H4EPYDAMIMO
ALPACA_API_SECRET=HvsFjtYDLgdYdb9oZBshuzWsFFAksJxBjnGvhvseXvkc

# Optional: data feed. "iex" (free) or "sip" (paid). Defaults to iex.
ALPACA_DATA_FEED=iex

# Optional: options feed. "indicative" (free, delayed/modified) or "opra" (paid).
ALPACA_OPTIONS_FEED=indicative

# =====================================================
# Risk (Phase 3) — position sizing assumptions
# =====================================================
ACCOUNT_CAPITAL=100000
RISK_PER_TRADE_PCT=0.01
MAX_POSITION_PCT=0.05
MIN_RISK_REWARD=1.0

# =====================================================
# Ollama local inference
# =====================================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:31b-cloud

# =====================================================
# Ollama web search (local experimental endpoint)
# Auth via OLLAMA_API_KEY (or `ollama signin`).
# =====================================================
OLLAMA_API_KEY=
OLLAMA_WEB_SEARCH_URL=http://localhost:11434/api/experimental/web_search
OLLAMA_WEB_FETCH_URL=http://localhost:11434/api/experimental/web_fetch
